<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PETEL_V2_Core\PETEL_V2_Core.csproj" />
    <ProjectReference Include="..\PETEL_Runner_V2\PETEL_Runner_V2.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <Target Name="CopyRunner" AfterTargets="Build">
    <ItemGroup>
      <RunnerFiles Include="..\PETEL_Runner_V2\bin\$(Configuration)\net8.0\PETEL_Runner_V2.*" />
    </ItemGroup>
    <Copy SourceFiles="@(RunnerFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
